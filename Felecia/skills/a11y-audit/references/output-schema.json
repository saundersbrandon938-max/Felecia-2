{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skilla11y.dev/schema/audit-v1.json",
  "title": "Accessibility Audit Output v1",
  "type": "object",
  "required": ["schema_version", "date", "tool", "standard", "pages", "summary", "violations", "matrix", "lighthouse"],
  "properties": {
    "schema_version": { "const": 1 },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tool": { "type": "string", "pattern": "^a11y-audit report\\.js v\\d+$" },
    "standard": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "runtime_url": { "type": "string", "format": "uri" },
    "expected_url": { "type": "string", "format": "uri" },
    "axe_version": { "type": "string" },
    "lighthouse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "skipped" },
            "reason": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "summary": {
      "type": "object",
      "required": ["critical", "serious", "moderate", "minor"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "serious": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "impact", "pages", "instances"],
        "properties": {
          "rule": { "type": "string" },
          "impact": {
            "type": ["string", "null"],
            "enum": ["critical", "serious", "moderate", "minor", null]
          },
          "wcag": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "pages": {
            "type": "array",
            "items": { "type": "string", "format": "uri" },
            "uniqueItems": true
          },
          "instances": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["pass", "fail", "manual", "not-applicable"]
      }
    },
    "criterion_review": {
      "type": "object",
      "additionalProperties": { "const": "needs-review" }
    },
    "audit_evidence": {
      "type": "object",
      "required": ["violations", "incomplete"],
      "properties": {
        "violations": { "$ref": "#/$defs/impactEvidence" },
        "incomplete": { "$ref": "#/$defs/impactEvidence" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["mode", "status", "major_impacts", "confirmed_major_instances", "nonblocking_instances", "best_practice_only_instances", "unknown_impact_instances", "blocking_incomplete_instances", "advisory_incomplete_instances", "scan_error_count", "reasons"],
      "properties": {
        "mode": { "const": "major" },
        "status": { "enum": ["pass", "fail", "inconclusive"] },
        "major_impacts": {
          "type": "array",
          "const": ["critical", "serious"]
        },
        "confirmed_major_instances": { "type": "integer", "minimum": 0 },
        "nonblocking_instances": { "type": "integer", "minimum": 0 },
        "best_practice_only_instances": { "type": "integer", "minimum": 0 },
        "unknown_impact_instances": { "type": "integer", "minimum": 0 },
        "blocking_incomplete_instances": { "type": "integer", "minimum": 0 },
        "advisory_incomplete_instances": { "type": "integer", "minimum": 0 },
        "scan_error_count": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": ["source", "totalPages", "selectedPages", "groups"],
      "properties": {
        "source": { "type": "string" },
        "originPolicy": { "type": ["string", "null"] },
        "discoveredOrigins": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "blockedFetches": { "type": "array" },
        "totalPages": { "type": "integer", "minimum": 0 },
        "selectedPages": { "type": "integer", "minimum": 0 },
        "groups": { "type": "array" }
      },
      "additionalProperties": true
    },
    "sharedTemplates": { "type": "array" },
    "delta": {
      "type": "object",
      "required": ["previousTotal", "currentTotal", "netDelta", "fixed", "newRules", "changed"],
      "additionalProperties": true
    }
  },
  "$defs": {
    "impactCounts": {
      "type": "object",
      "required": ["critical", "serious", "moderate", "minor", "unknown", "total"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "serious": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "impactEvidence": {
      "type": "object",
      "required": ["counts", "rules"],
      "properties": {
        "counts": { "$ref": "#/$defs/impactCounts" },
        "rules": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
